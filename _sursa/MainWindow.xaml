<Window x:Class="FallenStickers.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FallenStickers" Width="1020" Height="800" MinWidth="880" MinHeight="600"
        AllowDrop="True" WindowStartupLocation="CenterScreen"
        Background="#1E1F24" Foreground="#E8E8EC" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#2A2C33"/>
      <Setter Property="Foreground" Value="#E8E8EC"/>
      <Setter Property="BorderBrush" Value="#3A3D46"/>
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="CaretBrush" Value="#E8E8EC"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2F6FEB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="Gray" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#3A3D46"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E8E8EC"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="Step" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Foreground" Value="#C9CBD2"/>
    </Style>
    <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#3A3C44" Geometry="M0,0 H2 V2 H0Z"/>
          <GeometryDrawing Brush="#2C2E35" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z"/>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  </Window.Resources>
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="80"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="LangLbl" VerticalAlignment="Center" Foreground="#8A8D96" Margin="0,0,6,0"/>
        <ComboBox x:Name="LangCombo" Width="110" SelectionChanged="Lang_Changed"/>
        <TextBlock x:Name="AboutText" VerticalAlignment="Center" Foreground="#8A8D96" Margin="14,0,0,0">
          <Hyperlink x:Name="RepoLink" RequestNavigate="Link_Click" Foreground="#8A8D96"><Run x:Name="AboutRun"/></Hyperlink>
        </TextBlock>
      </StackPanel>
      <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Text="FallenStickers"/>
    </DockPanel>

    <Expander Grid.Row="1" x:Name="SettingsExp" Foreground="#E8E8EC" Margin="0,0,0,8">
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="20"/>
          <ColumnDefinition Width="460"/>
        </Grid.ColumnDefinitions>

        <!-- primii pași -->
        <Border Grid.Column="0" Background="#24262C" CornerRadius="6" Padding="12,10">
          <StackPanel>
            <TextBlock x:Name="GuideTitle" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
            <TextBlock Style="{StaticResource Step}">
              <Run x:Name="Step1a"/>
              <Hyperlink NavigateUri="https://my.telegram.org/apps" RequestNavigate="Link_Click" Foreground="#6EA2FF">my.telegram.org/apps</Hyperlink><Run x:Name="Step1b"/>
            </TextBlock>
            <TextBlock Style="{StaticResource Step}">
              <Run x:Name="Step2a"/>
              <Hyperlink NavigateUri="https://t.me/Stickers" RequestNavigate="Link_Click" Foreground="#6EA2FF">@Stickers</Hyperlink><Run x:Name="Step2b"/>
            </TextBlock>
            <TextBlock Style="{StaticResource Step}" x:Name="Step3"/>
            <TextBlock Style="{StaticResource Step}" x:Name="Step4"/>
            <TextBlock Style="{StaticResource Step}" x:Name="PrivacyNote" Foreground="#8A8D96" FontSize="12" Margin="0"/>
          </StackPanel>
        </Border>

        <!-- câmpuri -->
        <Grid Grid.Column="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="api_id" VerticalAlignment="Center"/>
          <TextBox Grid.Row="0" Grid.Column="1" x:Name="ApiIdBox" Margin="0,2"/>
          <TextBlock Grid.Row="1" Text="api_hash" VerticalAlignment="Center"/>
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="ApiHashBox" Margin="0,2"/>
          <TextBlock Grid.Row="2" x:Name="PhoneLbl" VerticalAlignment="Center"/>
          <TextBox Grid.Row="2" Grid.Column="1" x:Name="PhoneBox" Margin="0,2"/>
          <TextBlock Grid.Row="3" Text="Pack" VerticalAlignment="Center"/>
          <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,2">
            <Button DockPanel.Dock="Right" x:Name="PickBtn" Click="PickPack_Click" Margin="6,0,0,0" Padding="10,3"/>
            <TextBox x:Name="PackBox" TextChanged="PackBox_Changed"/>
          </DockPanel>
          <TextBlock Grid.Row="4" x:Name="EmojiLbl" VerticalAlignment="Center"/>
          <TextBox Grid.Row="4" Grid.Column="1" x:Name="EmojiBox" Margin="0,2" Width="80" HorizontalAlignment="Left" FontFamily="Segoe UI Emoji"/>
          <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,4,0,0">
            <CheckBox x:Name="AutoUploadChk"/>
            <CheckBox x:Name="AutoCloseChk"/>
          </StackPanel>
          <WrapPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,8,0,0">
            <Button x:Name="SaveBtn" Click="Save_Click" Margin="0,0,6,6"/>
            <Button x:Name="SendToBtn" Click="SendTo_Click" Margin="0,0,6,6" Style="{StaticResource Gray}"/>
            <Button x:Name="LogoutBtn" Click="Logout_Click" Margin="0,0,6,6" Style="{StaticResource Gray}"/>
          </WrapPanel>
        </Grid>
      </Grid>
    </Expander>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="300"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- stânga: lista -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="#3A3D46" BorderThickness="1" CornerRadius="6" Background="#24262C">
          <Grid>
            <TextBlock x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Foreground="#8A8D96" FontSize="15" TextWrapping="Wrap" Margin="20"/>
            <ListBox x:Name="List" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="List_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="2,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="72"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" Background="{StaticResource Checker}" CornerRadius="4">
                      <Image Source="{Binding Thumb}" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                      <TextBlock Text="{Binding Name}" Foreground="#E8E8EC" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Info}" Foreground="#8A8D96" FontSize="12"/>
                      <TextBlock Text="{Binding Status}" Foreground="#F0C060" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox Grid.Column="2" Text="{Binding Emoji, UpdateSourceTrigger=PropertyChanged}" Width="64"
                             FontSize="22" FontFamily="Segoe UI Emoji" HorizontalContentAlignment="Center"
                             VerticalAlignment="Center" ToolTip="Emoji (Win + .)"/>
                    <Button Grid.Column="3" Content="✕" Margin="6,0,0,0" Padding="8,4" Style="{StaticResource Gray}"
                            VerticalAlignment="Center" Click="Remove_Click" Tag="{Binding}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
        <WrapPanel Grid.Row="1" x:Name="QuickEmoji" Margin="0,8,0,0"/>
        <DockPanel Grid.Row="2" Margin="0,8,0,8">
          <Button x:Name="UploadBtn" DockPanel.Dock="Right" Click="Upload_Click" FontWeight="SemiBold"/>
          <Button x:Name="BrowseBtn" Click="Browse_Click" Style="{StaticResource Gray}" HorizontalAlignment="Left"/>
        </DockPanel>
      </Grid>

      <!-- dreapta: editor text -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Editor" Width="340" IsEnabled="False" Margin="0,0,4,8">
          <Border Width="300" Height="300" Background="{StaticResource Checker}" CornerRadius="6" ClipToBounds="True">
            <Image x:Name="Preview" Stretch="Uniform" Cursor="SizeAll"
                   MouseLeftButtonDown="Preview_MouseDown" MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseUp"/>
          </Border>
          <TextBlock x:Name="DragHint" Foreground="#8A8D96" FontSize="12" Margin="0,4,0,6"/>

          <TextBox x:Name="CapText" AcceptsReturn="True" Height="52" TextWrapping="Wrap" FontSize="15"
                   VerticalScrollBarVisibility="Auto" TextChanged="Style_Changed"/>

          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Font" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="FontCombo" SelectionChanged="Style_Changed" Margin="0,2" MaxDropDownHeight="400">
              <ComboBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
              </ComboBox.ItemsPanel>
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="15"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox Grid.Column="2" x:Name="BoldChk" Content="Bold" Margin="8,0,0,0" VerticalAlignment="Center"
                      Checked="Style_Changed" Unchecked="Style_Changed"/>

            <TextBlock Grid.Row="1" x:Name="SizeTxt" VerticalAlignment="Center"/>
            <Slider Grid.Row="1" Grid.Column="1" x:Name="SizeSlider" Minimum="12" Maximum="220" Margin="0,6"
                    ValueChanged="Style_Changed" IsMoveToPointEnabled="True"/>
            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="SizeLbl" Width="40" Margin="8,0,0,0" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="2" x:Name="OutlineTxt" VerticalAlignment="Center"/>
            <Slider Grid.Row="2" Grid.Column="1" x:Name="OutlineSlider" Minimum="0" Maximum="20" Margin="0,6"
                    ValueChanged="Style_Changed" IsMoveToPointEnabled="True"/>
            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="OutlineLbl" Width="40" Margin="8,0,0,0" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="3" x:Name="ColorTxt" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,3">
              <WrapPanel x:Name="FillSwatches" VerticalAlignment="Center"/>
              <TextBox x:Name="FillHex" Width="66" Margin="4,0,0,0" TextChanged="Style_Changed" FontFamily="Consolas"/>
            </StackPanel>

            <TextBlock Grid.Row="4" x:Name="OutColorTxt" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,3">
              <WrapPanel x:Name="OutlineSwatches" VerticalAlignment="Center"/>
              <TextBox x:Name="OutlineHex" Width="66" Margin="4,0,0,0" TextChanged="Style_Changed" FontFamily="Consolas"/>
            </StackPanel>
          </Grid>

          <WrapPanel Margin="0,8,0,0">
            <Button x:Name="TopBtn" Click="PosTop_Click" Style="{StaticResource Gray}" Padding="10,4" Margin="0,0,4,4"/>
            <Button x:Name="MidBtn" Click="PosMid_Click" Style="{StaticResource Gray}" Padding="10,4" Margin="0,0,4,4"/>
            <Button x:Name="BotBtn" Click="PosBot_Click" Style="{StaticResource Gray}" Padding="10,4" Margin="0,0,12,4"/>
            <Button x:Name="StyleAllBtn" Click="StyleAll_Click" Style="{StaticResource Gray}" Padding="10,4" Margin="0,0,4,4"/>
            <Button x:Name="ClearBtn" Click="ClearText_Click" Style="{StaticResource Gray}" Padding="10,4" Margin="0,0,4,4"/>
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <TextBox Grid.Row="3" x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
             FontFamily="Consolas" FontSize="12" Background="#16171B"/>
  </Grid>
</Window>
