<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <AssemblyName>FallenStickers</AssemblyName>
    <Version>2.0.0</Version>
    <Description>Upload pictures to your Telegram sticker pack in one click</Description>
    <Product>FallenStickers</Product>
    <Company>Fallen</Company>
    <Copyright>© 2026 Fallen</Copyright>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WTelegramClient" Version="4.4.10" />
  </ItemGroup>
</Project>
